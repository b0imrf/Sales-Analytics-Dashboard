<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit POS Config FORM view -->
    <record id="view_pos_config_form_inherit_branch" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.branch</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- TARGET FIXED: Finding the setting wrapper container by looking up its unique inner field layout tag -->
            <xpath expr="//field[@name='module_pos_hr']/ancestor::setting" position="before">
                <setting string="الفرع / Branch" help="Select the operational branch for this POS interface">
                    <field name="branch_id" options="{'no_create': True, 'no_open': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- Inherit POS Config LIST view -->
    <record id="view_pos_config_list_inherit_branch" model="ir.ui.view">
        <field name="name">pos.config.list.inherit.branch</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="branch_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
